# Dependencies and build output
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.next/
out/
build/
dist/
.open-next/
.wrangler/
/coverage
*.tsbuildinfo
next-env.d.ts

# Secrets. Never a key in the source: an RPC key ended up in the previous
# project's history and there is no getting it out again.
.env
.env.*
!.env.example
*.pem
*.key
id.json
keypair*.json
wallet*.json

# Card art. The finished art the site actually serves. The originals it is cut
# from are under art-source/ instead — see below. Untracked either way: that
# works right up until someone runs `git add .`, and then it is in the history
# for good. Large art belongs in storage with a CDN in front of it.
public/art/*
!public/art/README.md
# The full-size card images, for the same reason: served, not source, and sixty
# megabytes of it. See public/render/README.md for how to make them again.
public/render/*
!public/render/README.md

# The originals, kept as the master for anything printed or re-rendered later.
# npm run art:optimise moves them here as it converts, and the NFT collections a
# family's card art is cut from live here too.
#
# NOT in public/. Everything under public/ is uploaded to the site as-is, so the
# source art was being served from cardsofcronos.com and counted against the
# deploy: 813 MB of which 16 MB was actually used. A 43 MB zip in there is what
# finally broke the deploy, because Cloudflare refuses an asset over 25 MiB.
art-source/

# Heavy files
*.psd
*.ai
*.mp4
*.mov
assets/raw/

# Compiler output. The source is the record; ABIs are regenerated with
# `npm run compile` and a stale one committed beside a changed contract is a
# file that lies.
contracts/out/
contracts/cache/

# The orders exported out of the first version's Firestore. 67 people's e-mail
# addresses and 54 MB of artwork; neither belongs in a repository.
orders/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local
.DS_Store
*.local
.vercel
.claude/

# Generated by scripts/holder-drop.ts: one INSERT per holder, thousands of them.
# It is a cache of the chain, it is regenerated by running the script again, and
# it is not something a diff should ever be read.
data/holders.sql
data/holders-progress.json

# De leeuwen om uit te kiezen en het voorstel ernaast. Opgehaald uit
# github.com/LoadedLions/OpenLicense, dus opnieuw op te halen en niets om te
# bewaren in de geschiedenis.
lions-keuze/

# Pictures made for posting. They are output, not source: scripts/banner.ts and
# scripts/promo-wall.ts remake them in a minute, and a five-megabyte PNG in the
# history is there for good.
/banner.png
/banner.gif
/promo-wall.png
/promo-wall.jpg
/*-board.png
/*-board.jpg
/*-board-square.png
/*-board-square.jpg
/*-cards.png
/*-cards.jpg
/promo/
/promo-square/
/promo-square.png
/promo-square.jpg
/*-square.png
/*-square.jpg
