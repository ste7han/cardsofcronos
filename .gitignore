# Dependencies and build output
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.next/
out/
build/
dist/
.open-next/
.wrangler/
/coverage
*.tsbuildinfo
next-env.d.ts

# Secrets. Never a key in the source: an RPC key ended up in the previous
# project's history and there is no getting it out again.
.env
.env.*
!.env.example
*.pem
*.key
id.json
keypair*.json
wallet*.json

# Card art. 734 MB of finished NFT renders sit in public/NFTCARDS, untracked.
# That works right up until someone runs `git add .`, and then it is in the
# history for good. Large art belongs in storage with a CDN in front of it.
public/NFTCARDS/
public/art/*
!public/art/README.md

# The originals, kept as the master for anything printed or re-rendered later.
# npm run art:optimise moves them here as it converts.
art-source/

# Heavy files
*.psd
*.ai
*.mp4
*.mov
assets/raw/

# Compiler output. The source is the record; ABIs are regenerated with
# `npm run compile` and a stale one committed beside a changed contract is a
# file that lies.
contracts/out/
contracts/cache/

# The orders exported out of the first version's Firestore. 67 people's e-mail
# addresses and 54 MB of artwork; neither belongs in a repository.
orders/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local
.DS_Store
*.local
.vercel
.claude/
