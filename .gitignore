# Dependencies and build output
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.next/
out/
build/
dist/
.open-next/
.wrangler/
/coverage
*.tsbuildinfo
next-env.d.ts

# Python — the old game-engine cloud function. Goes away in the last phase of
# the rebuild; the ignore stays until it does.
venv/
__pycache__/
*.pyc

# Secrets. Never a key in the source: an RPC key ended up in the previous
# project's history and there is no getting it out again.
.env
.env.*
!.env.example
*.pem
*.key
id.json
keypair*.json
wallet*.json
/credentials/

# Card art. 734 MB of finished NFT renders sit in public/NFTCARDS, untracked.
# That works right up until someone runs `git add .`, and then it is in the
# history for good. Large art belongs in storage with a CDN in front of it.
public/NFTCARDS/
public/art/*
!public/art/README.md

# The originals, kept as the master for anything printed or re-rendered later.
# npm run art:optimise moves them here as it converts.
art-source/

# Heavy files
*.psd
*.ai
*.mp4
*.mov
assets/raw/

# Local snapshots and backups — not source. Cleared out in the last phase.
*.zip
*kopie/
web3.ts.patch.*

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Local
.DS_Store
*.local
.vercel
.claude/
