# Copy to .env.local and fill in. .env.local is in .gitignore.
# Never a real key in a file that does get committed: an RPC key ended up in the
# previous project's history and there is no getting it out again.

# Public address of the TCG token once it is live on pump.fun.
NEXT_PUBLIC_TCG_MINT=

# RPC endpoint. Solana's public one works, but it is slow and rate limited.
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
