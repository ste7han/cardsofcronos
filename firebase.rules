rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCTIES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incomingData() {
      return request.resource.data;
    }

    function isValidRequest() {
      let data = incomingData();
      let requiredStrings = ['type', 'rarity', 'name', 'description', 'imageUrl', 'socialLink', 'transactionHash', 'email', 'status'];

      return
        data.keys().hasAll(requiredStrings) &&
        data.burnAmount is number &&
        data.createdAt is timestamp &&
        data.name is string && data.description is string && data.imageUrl is string &&
        data.type in ['Project', 'Roast', 'Influencer', 'Special'] &&
        data.rarity in ['Epic', 'Rare', 'Mythical'] &&
        data.status in ['pending', 'completed', 'rejected'];
    }

    // --- DE REGELS ---

    // 1. Matches (Replays)
    // Alleen de game-engine (Admin SDK) schrijft hier; die omzeilt deze regels.
    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    // 2. LOBBIES
    //
    // Stond op `allow update: if true`. Daarmee kon iedereen elke lobby
    // overschrijven — inclusief een verzonnen battleResult, dat de tegenstander
    // vervolgens blind vertrouwde. Nu geldt:
    //   - status / battleResult / matchId schrijft ALLEEN de server;
    //   - de host schrijft alleen hostDeck, de gast alleen guestDeck;
    //   - een deck kan maar één keer vastgelegd worden.
    //
    // De binding gebeurt op auth.uid, niet op walletadres: een adres in een
    // document is niet meer dan een string die iedereen kan invullen.
    match /lobbies/{lobbyId} {
      function existing() { return resource.data; }
      function incoming() { return request.resource.data; }
      function touched() { return incoming().diff(existing()).affectedKeys(); }

      function isHost() { return isSignedIn() && request.auth.uid == existing().hostUid; }
      function isGuest() { return isSignedIn() && request.auth.uid == existing().guestUid; }

      // Een gast neemt de open plek in.
      function isJoining() {
        return isSignedIn()
          && existing().status == 'waiting'
          && existing().guestUid == null
          && touched().hasOnly(['guestAddress', 'guestUid', 'status'])
          && incoming().status == 'selecting_decks'
          && incoming().guestUid == request.auth.uid
          && incoming().guestAddress is string
          && request.auth.uid != existing().hostUid;
      }

      function isValidDeck(deck) {
        return deck is list && deck.size() == 11;
      }

      // Deck vastleggen: alleen je eigen veld, en alleen als het nog leeg is.
      function isLockingHostDeck() {
        return isHost()
          && touched().hasOnly(['hostDeck'])
          && existing().hostDeck == null
          && isValidDeck(incoming().hostDeck);
      }

      function isLockingGuestDeck() {
        return isGuest()
          && touched().hasOnly(['guestDeck'])
          && existing().guestDeck == null
          && isValidDeck(incoming().guestDeck)
          && existing().status == 'selecting_decks';
      }

      allow read: if true;

      allow create: if isSignedIn()
        && incoming().keys().hasOnly(['hostAddress', 'hostUid', 'wager', 'status', 'createdAt', 'hostDeck', 'guestDeck', 'guestAddress', 'guestUid'])
        && incoming().hostUid == request.auth.uid
        && incoming().hostAddress is string
        && incoming().wager is number
        && incoming().status == 'waiting'
        && incoming().hostDeck == null
        && incoming().guestDeck == null;

      allow update: if isJoining() || isLockingHostDeck() || isLockingGuestDeck();

      // De host mag zijn eigen lobby opruimen zolang er niet gevochten wordt.
      allow delete: if isHost() && existing().status in ['waiting', 'selecting_decks'];
    }

    // 3. Stats
    match /stats/burnStats {
      allow read: if true;
      allow write: if isSignedIn()
        && incomingData().totalBurned is number
        && incomingData().totalRequests is number;
    }

    // 4. Requests (Met jouw validatie)
    match /requests/{requestId} {
      allow create: if isValidRequest();
    }

    // 5. Vangnet
    match /{document=**} {
      allow read: if isSignedIn();
    }
  }
}
