rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCTIES ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function incomingData() {
      return request.resource.data;
    }
    
    function isValidRequest() {
      let data = incomingData();
      let requiredStrings = ['type', 'rarity', 'name', 'description', 'imageUrl', 'socialLink', 'transactionHash', 'email', 'status'];
      
      return 
        data.keys().hasAll(requiredStrings) &&
        data.burnAmount is number &&
        data.createdAt is timestamp &&
        data.name is string && data.description is string && data.imageUrl is string &&
        data.type in ['Project', 'Roast', 'Influencer', 'Special'] &&
        data.rarity in ['Epic', 'Rare', 'Mythical'] &&
        data.status in ['pending', 'completed', 'rejected'];
    }

    // --- DE REGELS ---

    // 1. Matches (Replays)
    match /matches/{matchId} {
      allow read: if true;
      allow write: if false; 
    }

    // 2. LOBBIES (NIEUW: Dit miste je!)
    // Hiermee kunnen spelers lobbies aanmaken en joinen
    match /lobbies/{lobbyId} {
      allow read: if true;
      allow create: if true; // In productie: if isSignedIn()
      allow update: if true; // Nodig om te joinen en decks op te slaan
    }

    // 3. Stats
    match /stats/burnStats {
      allow read: if true;
      allow write: if incomingData().totalBurned is number && incomingData().totalRequests is number;
    }

    // 4. Requests (Met jouw validatie)
    match /requests/{requestId} {
      allow create: if isValidRequest(); 
    }

    // 5. Vangnet
    match /{document=**} {
      allow read: if isSignedIn();
    }
  }
}