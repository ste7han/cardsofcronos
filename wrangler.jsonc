{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A wrapper round the generated worker, not the generated worker itself.
  // OpenNext rewrites .open-next/worker.js on every build and it only has a
  // fetch handler; worker/index.js re-exports it and adds the scheduled one the
  // cron below needs.
  "main": "worker/index.js",
  "name": "cards-of-cronos",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // The domain, attached by the deploy rather than by hand in a dashboard, so
  // it is in version control and a fresh clone deploys to the same place.
  //
  // No custom domain yet, so this deploys to its workers.dev subdomain.
  //
  // The domain moved to this account on 2026-08-23: its nameservers went from
  // Hostnet to Cloudflare, and these two routes took the apex and www off the
  // old Firebase site. Wrangler owns those DNS records now — it writes them on
  // deploy, which is why they are here and not in a dashboard.
  //
  // What that move had to preserve, and in what order, is in
  // docs/domein-overzetten.md.
  "routes": [
    { "pattern": "cardsofcronos.com", "custom_domain": true },
    { "pattern": "www.cardsofcronos.com", "custom_domain": true }
  ],
  // Two ticks, and worker/index.js decides which route each one goes to.
  //
  // Daily at 00:10 UTC: call release() on the splitter and write down what it
  // burned. Nothing was calling it, so the CRO sat there and /burn read zero.
  //
  // Monday at 00:20 UTC: close the week and pay its winner. The week closes at
  // midnight — see lib/tournament.ts — and twenty minutes is enough slack that
  // a tick firing early does not close the week that is still running. It is
  // also after the daily one, so the last release of the week has landed in the
  // pot before the pot is handed over.
  // Every minute: read the blocks since the last tick and post what happened to
  // Discord — cards minted, $CROCARD bought, $CROCARD burned. A feed that
  // reports a mint an hour later is not a feed, which is why this one is not
  // folded into the daily tick above.
  "triggers": {
    "crons": ["* * * * *", "10 0 * * *", "20 0 * * 1"]
  },
  "workers_dev": true,
  // Keep the logs, rather than only being able to watch them live.
  //
  // `wrangler tail` shows what is happening while you are looking, which is no
  // use for the jobs here: they fire at ten past midnight, twenty past on a
  // Monday, and every minute. A cron that failed last night leaves nothing
  // behind without this, and the first version of this project's scheduled work
  // was debugged by guessing for exactly that reason.
  //
  // It also survived the case that prompted it: a tail that sat connected
  // through requests which demonstrably reached the Worker and reported none of
  // them.
  "observability": {
    "enabled": true
  },
  // Cloudflare's SQLite, on this account, free at this size. A match is a seed
  // and a list of moves — a few hundred bytes — so the storage this game needs
  // is small enough that a separate database vendor would be a bill for nothing.
  //
  // Its own database, deliberately. The account also has one called `trenches`,
  // and two games writing to one set of player and match tables would be a mess
  // nobody could unpick afterwards.
  // A clock that is not a Cron Trigger.
  //
  // Cloudflare stopped invoking this Worker's scheduled handler on 21 September
  // 2026 and nothing on this side brought it back — docs/the-discord-feeds.md
  // lists what was ruled out. Durable Object alarms are a different subsystem,
  // so the Discord feeds get their minute from one object holding one alarm
  // that re-books itself. The crons above are left in place: if they start
  // working again they simply join in, and the route declines a run that has
  // just happened either way.
  //
  // SQLite-backed, which is what the Workers Free plan allows.
  //
  // ── EVERY DEPLOY WARNS ABOUT THIS CLASS, AND IT IS NOTHING ───────────────
  //
  //   workerd: A DurableObjectNamespace in the config referenced the class
  //   "FeedTicker", but no such Durable Object class is exported from the
  //   worker. Attempts to call to this Durable Object class will fail at
  //   runtime.
  //
  // It is alarming and it is about a step that has nothing to do with what gets
  // uploaded. Before deploying, OpenNext starts a LOCAL worker to populate the
  // static-assets cache, and that one is entered at `.open-next/worker.js` —
  // which does not export FeedTicker, because FeedTicker lives in
  // worker/index.js, the file that WRAPS the OpenNext worker and is `main`
  // above. Wrangler says as much in its own warning two lines earlier: "These
  // will not work in local development, but they should work in production."
  //
  // Checked rather than assumed, on 28 September 2026:
  //   - `opennextjs-cloudflare build` on its own prints no such warning;
  //   - the deployed version lists `env.FEED_TICKER (FeedTicker) Durable
  //     Object` among its bindings, with handlers fetch and scheduled;
  //   - the alarm demonstrably runs — the feed cursors move every minute.
  //
  // So: not a symptom. If the clock ever does stop, the thing to look at is the
  // alarm re-booking itself in worker/index.js, not this warning.
  "durable_objects": {
    "bindings": [
      {
        "name": "FEED_TICKER",
        "class_name": "FeedTicker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FeedTicker"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cards-of-cronos",
      "database_id": "6f5ea7d1-fdf2-4016-9623-a7ee2e7d195a"
    }
  ]
  // No vars yet. X_CLIENT_ID lived here in Trenches — it is that project's X
  // app, and reusing it would sign Cards of Cronos players into the wrong one.
  // Register a separate app when linking arrives; the client id is public and
  // belongs here, its secret is a Worker secret set with `wrangler secret put`
  // and never appears in a file.
  //
  // Deliberately no R2 incremental cache and no images binding, which the
  // adapter's template ships with. R2 is not in this account's token scopes,
  // and nothing here uses next/image — card art is a plain img with a content
  // hash in the URL.
}
